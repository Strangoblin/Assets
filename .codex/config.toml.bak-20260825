# ============================================================
# Codex 配置 — OpenCode Go 直连模板（2026-08-17 起无代理方案）
# ⚠️ 本文件是【模板】：实际生效的是全局 ~/.codex/config.toml。
#    Codex 项目级 .codex/config.toml 不支持 provider 类 key
#    （model_provider / [model_providers] 会被忽略并打 warning），
#    修改后请同步到全局 ~/.codex/config.toml。
# 目标机安装：cp 本文件到 ~/.codex/config.toml
# 同时需 ~/.codex/auth.json：{"OPENAI_API_KEY": "sk-..."} (chmod 600)
# 注意：Codex 26.803+（CLI v0.147+）只支持 wire_api = "responses"
# ============================================================

# 主模型：deepseek-v4-flash（快；需 CN opt-in，本区域实测可用）
# ⚠️ 403 根因：auto_review 审批走独立模型 codex-auto-review（本区域不可用），
#    与主模型无关——必须显式设置 review_model 指向本区域可用模型。
# 备选：deepseek-v4-pro / mimo-v2.5 / gpt-5.6-luna / glm-5.2 / qwen3.8-max / kimi-k3 / minimax-m3
model = "deepseek-v4-flash"
# 审查模型：显式指向主模型同款（快 + 本区域可用），否则提权全部 403。
review_model = "deepseek-v4-flash"
model_provider = "opencode-go"
model_reasoning_effort = "high"
disable_response_storage = true

[model_providers.opencode-go]
name = "OpenCode Go"
# ⚠️ 直连 base_url 必须带 /v1，否则 404 HTML 页
base_url = "https://opencode.ai/zen/go/v1"
wire_api = "responses"
stream_idle_timeout_ms = 300000
request_max_retries = 2
stream_max_retries = 2

[projects."/Users/xiaokangji/Unity/Lab"]
trust_level = "trusted"
